		summarizeBy: none
		sourceColumn: Date

		variation Variation
			isDefault
			relationship: 65ad92c1-5602-440c-b7e6-7b34ed53e702
			defaultHierarchy: LocalDateTable_2727ff58-a2e6-4f55-9187-71b85ebd484e.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column MonthStart
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: 9d59498c-2be8-4ed6-b87c-d334f1d30b83
		summarizeBy: none
		sourceColumn: MonthStart

		variation Variation
			isDefault
			relationship: dbb27467-935c-4abc-b765-4e95c0d132ac
			defaultHierarchy: LocalDateTable_0ded72c9-a30a-4e62-9f25-43b1e9acb79d.'Date Hierarchy'

